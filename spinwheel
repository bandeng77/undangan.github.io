<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Wheel of Fortune | Lucky Draw Hadiah Spesial</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(145deg, #0f111a 0%, #1e2436 100%);
            font-family: 'Poppins', 'Segoe UI', system-ui, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(circle at 20% 40%, rgba(255,215,0,0.06) 2px, transparent 2px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        .wheel-container {
            max-width: 1400px;
            width: 100%;
            background: rgba(0,0,0,0.45);
            backdrop-filter: blur(12px);
            border-radius: 64px;
            padding: 20px 30px 35px;
            box-shadow: 0 30px 50px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,215,0,0.2);
            border: 1px solid rgba(255,215,0,0.35);
        }

        .event-header {
            text-align: center;
            margin-bottom: 15px;
        }

        .event-header h1 {
            font-size: 2.3rem;
            background: linear-gradient(135deg, #FFE0A3, #FFB347);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 2px;
        }

        .event-header p {
            color: #ccc;
            font-size: 0.9rem;
        }

        .main-layout {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: center;
            margin: 20px 0 25px;
        }

        .wheel-section {
            flex: 1;
            min-width: 320px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        canvas {
            width: 460px;
            height: 460px;
            max-width: 100%;
            border-radius: 50%;
            box-shadow: 0 20px 35px rgba(0,0,0,0.5), 0 0 0 10px rgba(255,215,0,0.2), 0 0 0 16px rgba(0,0,0,0.4);
            background: #2a2f3f;
        }

        .spin-btn {
            margin-top: 30px;
            background: linear-gradient(120deg, #FFD966, #FFA559);
            border: none;
            padding: 14px 45px;
            font-size: 1.4rem;
            font-weight: bold;
            border-radius: 60px;
            color: #1e1e2a;
            cursor: pointer;
            box-shadow: 0 8px 0 #b4621a;
            transition: 0.08s linear;
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        .spin-btn:active {
            transform: translateY(4px);
            box-shadow: 0 4px 0 #b4621a;
        }

        .spin-btn:disabled {
            opacity: 0.6;
            transform: none;
            cursor: not-allowed;
        }

        /* Prize Panel */
        .info-panel {
            flex: 0.9;
            min-width: 300px;
            background: rgba(10, 14, 23, 0.8);
            backdrop-filter: blur(12px);
            border-radius: 48px;
            padding: 20px;
            border: 1px solid rgba(255,215,0,0.4);
        }

        .prize-selector {
            background: linear-gradient(135deg, #1e2436, #151a28);
            border-radius: 32px;
            padding: 15px;
            margin-bottom: 20px;
            border: 1px solid rgba(255,215,0,0.3);
        }

        .prize-title {
            font-size: 1rem;
            color: #FFD966;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .prize-options {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 10px;
        }

        .prize-card {
            background: rgba(0,0,0,0.55);
            border-radius: 20px;
            padding: 8px 6px;
            cursor: pointer;
            transition: all 0.2s;
            border: 2px solid transparent;
            text-align: center;
        }

        .prize-card:hover:not(.disabled) {
            transform: translateY(-3px);
            background: rgba(255,215,0,0.2);
        }

        .prize-card.selected {
            border-color: #FFD966;
            background: linear-gradient(135deg, rgba(255,215,0,0.3), rgba(255,180,0,0.2));
            box-shadow: 0 0 12px rgba(255,215,0,0.5);
        }

        .prize-card.disabled {
            opacity: 0.4;
            cursor: not-allowed;
            filter: grayscale(0.3);
        }

        .prize-name {
            font-weight: bold;
            color: #fff;
            font-size: 0.85rem;
        }

        .prize-stock {
            font-size: 0.7rem;
            color: #FFD966;
            margin-top: 4px;
        }

        .prize-icon {
            font-size: 1.5rem;
        }

        .winner-card {
            text-align: center;
            background: linear-gradient(135deg, #1e2436, #131826);
            border-radius: 40px;
            padding: 18px 12px;
            margin-bottom: 18px;
            border-bottom: 3px solid #FFD966;
        }

        .winner-label {
            font-size: 0.75rem;
            letter-spacing: 3px;
            color: #FFD966;
        }

        .winner-name {
            font-size: 1.5rem;
            font-weight: 800;
            margin: 6px 0;
            background: linear-gradient(135deg, #fff, #FFE0A3);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .winner-company, .winner-prize {
            font-size: 0.9rem;
            background: rgba(255,215,0,0.18);
            display: inline-block;
            padding: 4px 14px;
            border-radius: 40px;
            margin: 4px 5px;
            color: #FFE0A3;
        }

        .guest-stats {
            background: rgba(0,0,0,0.4);
            border-radius: 28px;
            padding: 12px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            color: #ddd;
            padding: 5px 0;
            font-size: 0.8rem;
        }

        .history-section {
            margin-top: 20px;
            background: rgba(0,0,0,0.4);
            border-radius: 32px;
            padding: 16px;
        }

        .history-list {
            max-height: 200px;
            overflow-y: auto;
        }

        .history-item {
            background: rgba(255,255,255,0.07);
            margin: 6px 0;
            padding: 8px 12px;
            border-radius: 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 5px;
            border-left: 3px solid #FFD966;
        }

        .history-prize {
            background: #FFD966;
            color: #1e1e2a;
            padding: 2px 12px;
            border-radius: 30px;
            font-size: 0.7rem;
            font-weight: bold;
        }

        .reset-btn {
            background: rgba(220, 53, 69, 0.85);
            border: none;
            padding: 6px 18px;
            border-radius: 40px;
            color: white;
            cursor: pointer;
            margin-top: 10px;
            font-size: 0.8rem;
        }

        .toast-msg {
            position: fixed;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            background: #FFD966;
            color: #1e1e2a;
            padding: 10px 24px;
            border-radius: 50px;
            font-weight: bold;
            z-index: 1100;
            opacity: 0;
            transition: 0.2s;
            pointer-events: none;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 2000;
            display: none;
            justify-content: center;
            align-items: center;
        }

        .spinner {
            width: 55px;
            height: 55px;
            border: 5px solid rgba(255,215,0,0.3);
            border-top: 5px solid #FFD966;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
    </style>
