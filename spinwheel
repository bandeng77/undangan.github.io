    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-database-compat.js"></script>
</head>
<body>

<div class="wheel-container">
    <div class="event-header">
        <h1><i class="fas fa-gift"></i> Lucky Draw Wedding</h1>
        <p>Pilih hadiah dulu, lalu putar roda! Durasi spin 8 detik ✨</p>
    </div>

    <div class="main-layout">
        <div class="wheel-section">
            <canvas id="wheelCanvas" width="500" height="500"></canvas>
            <button class="spin-btn" id="spinButton"><i class="fas fa-play"></i> SPIN (8 detik)</button>
        </div>

        <div class="info-panel">
            <div class="prize-selector">
                <div class="prize-title"><i class="fas fa-trophy"></i> Pilih Hadiah Sebelum Spin</div>
                <div class="prize-options" id="prizeContainer"></div>
            </div>
            <div class="winner-card">
                <div class="winner-label">🏆 PEMENANG TERBARU 🏆</div>
                <div class="winner-name" id="winnerName">—</div>
                <div id="winnerCompany" class="winner-company">—</div>
                <div id="winnerPrizeDisplay" class="winner-prize">—</div>
            </div>
            <div class="guest-stats">
                <div class="stat-item"><span><i class="fas fa-users"></i> Total Tamu</span><span id="totalGuests">0</span></div>
                <div class="stat-item"><span><i class="fas fa-history"></i> Sudah Menang</span><span id="wonCount">0</span></div>
                <div class="stat-item"><span><i class="fas fa-undo-alt"></i> Sisa Belum Menang</span><span id="remainingCount">0</span></div>
            </div>
        </div>
    </div>

    <div class="history-section">
        <div class="history-title"><i class="fas fa-list-ul"></i> History Pemenang & Hadiah</div>
        <div class="history-list" id="historyList">Memuat...</div>
        <div style="display: flex; justify-content: flex-end;">
            <button class="reset-btn" id="resetAllBtn"><i class="fas fa-trash-alt"></i> Reset Semua Pemenang</button>
        </div>
    </div>
</div>
<div id="toastMsg" class="toast-msg"></div>
<div class="loading-overlay" id="loadingOverlay"><div class="spinner"></div></div>

<script>
    // ---------- FIREBASE (sama dengan admin panel) ----------
    const firebaseConfig = {
        apiKey: "AIzaSyC8LlcI_ccRGieFNjlVFLfEr2c4PBg6J70",
        authDomain: "logbook-e6ab3.firebaseapp.com",
        databaseURL: "https://logbook-e6ab3-default-rtdb.asia-southeast1.firebasedatabase.app",
        projectId: "logbook-e6ab3",
        storageBucket: "logbook-e6ab3.firebasestorage.app",
        messagingSenderId: "484546392348",
        appId: "1:484546392348:web:861616b680427c158ecad9"
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();
    const rsvpRef = database.ref('rsvps');
    const winnersRef = database.ref('wheel_winners_v2'); // menyimpan { name, company, prize, timestamp }

    // ---------- DAFTAR HADIAH (dengan stok) ----------
    let prizes = [
        { id: "tv", name: "TV 43 Inch", icon: "📺", stock: 1, initialStock: 1 },
        { id: "smartphone", name: "Smartphone", icon: "📱", stock: 2, initialStock: 2 },
        { id: "speaker", name: "Speaker Portable", icon: "🔊", stock: 1, initialStock: 1 },
        { id: "tws", name: "TWS Earbud", icon: "🎧", stock: 1, initialStock: 1 },
        { id: "smartwatch", name: "Smartwatch", icon: "⌚", stock: 1, initialStock: 1 }
    ];

    let guestsList = [];            // { id, name, company }
    let winnersHistory = [];        // { name, company, prize, timestamp }
    let availableIndices = [];      // index di guestsList yang belum pernah menang
    let currentSpinInProgress = false;
    let animationId = null;
    let currentRotation = 0;
    let spinStartTime = 0;
    const SPIN_DURATION = 8000;     // 8 detik penuh
    let targetSegmentIndex = -1;
    let wheelSegments = [];
    let selectedPrize = null;       // prize object yang dipilih

    const canvas = document.getElementById('wheelCanvas');
    const ctx = canvas.getContext('2d');
    const spinBtn = document.getElementById('spinButton');

    // Helper UI
    function showLoading(show) {
        const overlay = document.getElementById('loadingOverlay');
        if (show) overlay.style.display = 'flex';
        else overlay.style.display = 'none';
    }

    function showToast(msg, isError = false) {
        const toast = document.getElementById('toastMsg');
        toast.innerText = msg;
        toast.style.backgroundColor = isError ? '#e74c3c' : '#FFD966';
        toast.style.opacity = '1';
        setTimeout(() => toast.style.opacity = '0', 2800);
    }

    // Konfetti sederhana
    function startConfetti() {
        let canvasConf = document.createElement('canvas');
        canvasConf.style.position = 'fixed';
        canvasConf.style.top = '0';
        canvasConf.style.left = '0';
        canvasConf.style.width = '100%';
        canvasConf.style.height = '100%';
        canvasConf.style.pointerEvents = 'none';
        canvasConf.style.zIndex = '9999';
        document.body.appendChild(canvasConf);
        let w = window.innerWidth, h = window.innerHeight;
        canvasConf.width = w;
        canvasConf.height = h;
        let ctxc = canvasConf.getContext('2d');
        let particles = [];
        for (let i = 0; i < 180; i++) {
            particles.push({
                x: Math.random() * w,
                y: Math.random() * h - h,
                size: Math.random() * 7 + 3,
                color: `hsl(${Math.random() * 360}, 100%, 60%)`,
                speedY: Math.random() * 7 + 4,
                speedX: (Math.random() - 0.5) * 3
            });
        }
        let startTime = performance.now();
        function animate(now) {
            if (now - startTime > 2800) { canvasConf.remove(); return; }
            ctxc.clearRect(0, 0, w, h);
            let alive = false;
            for (let p of particles) {
                p.y += p.speedY;
                p.x += p.speedX;
                if (p.y < h + 40) alive = true;
                ctxc.fillStyle = p.color;
                ctxc.fillRect(p.x - p.size/2, p.y - p.size/2, p.size, p.size);
            }
            if (alive) requestAnimationFrame(animate);
            else canvasConf.remove();
        }
        requestAnimationFrame(animate);
    }

    // ---------- LOAD DATA TAMU DARI RSVP ----------
    async function loadGuests() {
        showLoading(true);
        try {
            const snap = await rsvpRef.once('value');
            const data = snap.val();
            if (data) {
                guestsList = Object.keys(data).map(key => ({
                    id: key,
                    name: data[key].name || 'Tanpa Nama',
                    company: data[key].company || '-'
                })).filter(g => g.name && g.name.trim() !== '');
            } else {
                guestsList = [];
            }
            await loadWinnersHistory();
            updateAvailableIndices();
            renderPrizeOptions();
            drawWheel();
            updateStatsUI();
            if (guestsList.length === 0) showToast("Belum ada data RSVP, silakan isi form undangan", true);
        } catch(e) { showToast("Gagal muat data", true); } 
        finally { showLoading(false); }
    }

    async function loadWinnersHistory() {
        const snap = await winnersRef.once('value');
        const data = snap.val();
        if (data) {
            winnersHistory = Object.keys(data).map(key => ({ id: key, ...data[key] }))
                .sort((a,b) => (b.timestamp||0) - (a.timestamp||0));
        } else { winnersHistory = []; }
        // update stok hadiah berdasarkan history
        resetPrizeStockFromHistory();
        renderHistory();
        updateStatsUI();
    }

    function resetPrizeStockFromHistory() {
        // reset stok ke awal
        prizes.forEach(p => p.stock = p.initialStock);
        // kurangi berdasarkan pemenang sebelumnya
        winnersHistory.forEach(w => {
            const prizeName = w.prize;
            const prizeItem = prizes.find(p => p.name === prizeName);
            if (prizeItem && prizeItem.stock > 0) prizeItem.stock--;
        });
        renderPrizeOptions();
    }

    function updateAvailableIndices() {
        const winnerNames = new Set(winnersHistory.map(w => w.name));
        availableIndices = [];
        for (let i = 0; i < guestsList.length; i++) {
            if (!winnerNames.has(guestsList[i].name)) availableIndices.push(i);
        }
        spinBtn.disabled = (availableIndices.length === 0);
        if (availableIndices.length === 0 && guestsList.length) showToast("Semua tamu sudah pernah menang! Reset history untuk spin lagi", false);
        updateStatsUI();
    }

    function updateStatsUI() {
        document.getElementById('totalGuests').innerText = guestsList.length;
        document.getElementById('wonCount').innerText = winnersHistory.length;
        document.getElementById('remainingCount').innerText = guestsList.length - winnersHistory.length;
    }

    // Render pilihan hadiah
    function renderPrizeOptions() {
        const container = document.getElementById('prizeContainer');
        container.innerHTML = prizes.map(prize => `
            <div class="prize-card ${selectedPrize?.id === prize.id ? 'selected' : ''} ${prize.stock <= 0 ? 'disabled' : ''}" data-id="${prize.id}">
                <div class="prize-icon">${prize.icon}</div>
                <div class="prize-name">${prize.name}</div>
                <div class="prize-stock"><i class="fas fa-boxes"></i> Sisa: ${prize.stock}</div>
            </div>
        `).join('');
        document.querySelectorAll('.prize-card').forEach(card => {
            card.addEventListener('click', (e) => {
                e.stopPropagation();
                const id = card.getAttribute('data-id');
                const prize = prizes.find(p => p.id === id);
                if (!prize || prize.stock <= 0) {
                    showToast(`Stok ${prize?.name} habis!`, true);
                    return;
                }
                if (currentSpinInProgress) {
                    showToast("Tunggu spin selesai sebelum ganti hadiah", true);
                    return;
                }
                selectedPrize = prize;
                renderPrizeOptions();
                showToast(`Hadiah dipilih: ${prize.name}`, false);
            });
        });
    }

    // Gambar roda berdasarkan availableIndices (hanya yg belum pernah menang)
    function drawWheel() {
        if (!guestsList.length || availableIndices.length === 0) {
            ctx.clearRect(0, 0, 500, 500);
            ctx.fillStyle = "#FFD966";
            ctx.font = "bold 16px 'Segoe UI'";
            ctx.fillText("Tidak ada peserta", 170, 250);
            return;
        }
        const segmentIndices = [...availableIndices];
        wheelSegments = segmentIndices.map(idx => guestsList[idx]);
        const count = wheelSegments.length;
        const angleStep = (Math.PI * 2) / count;
        for (let i = 0; i < count; i++) {
            const start = i * angleStep + currentRotation;
            const end = (i + 1) * angleStep + currentRotation;
            const hue = (i * 45) % 360;
            ctx.beginPath();
            ctx.fillStyle = `hsl(${hue}, 70%, 55%)`;
            ctx.moveTo(250, 250);
            ctx.arc(250, 250, 250, start, end);
            ctx.fill();
            ctx.save();
            ctx.translate(250, 250);
            ctx.rotate(start + angleStep / 2);
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            let shortName = wheelSegments[i].name.length > 15 ? wheelSegments[i].name.substring(0,13)+".." : wheelSegments[i].name;
            ctx.font = "bold 13px 'Segoe UI'";
            ctx.fillStyle = "#1a1f2e";
            ctx.shadowBlur = 0;
            ctx.fillText(shortName, 125, 5);
            ctx.font = "9px 'Segoe UI'";
            ctx.fillStyle = "#2c2e3a";
            let shortComp = wheelSegments[i].company.length > 14 ? wheelSegments[i].company.substring(0,11)+".." : wheelSegments[i].company;
            ctx.fillText(shortComp, 125, 22);
            ctx.restore();
        }
        // Pointer segitiga
        ctx.beginPath();
        ctx.moveTo(475, 240);
        ctx.lineTo(495, 250);
        ctx.lineTo(475, 260);
        ctx.fillStyle = "#FFD966";
        ctx.fill();
        ctx.fillStyle = "#000";
        ctx.font = "bold 18px sans-serif";
        ctx.fillText("⬆️", 478, 245);
    }

    // SPIN dengan durasi 8 detik (perlambatan cubic)
    async function spinWheel() {
        if (currentSpinInProgress) { showToast("Spin sedang berjalan...", true); return; }
        if (!guestsList.length) { showToast("Data tamu kosong", true); return; }
        if (availableIndices.length === 0) { showToast("Semua tamu sudah pernah menang! Reset history", true); return; }
        if (!selectedPrize) { showToast("Silakan pilih hadiah terlebih dahulu!", true); return; }
        if (selectedPrize.stock <= 0) { showToast(`Stok ${selectedPrize.name} habis, pilih hadiah lain`, true); return; }

        currentSpinInProgress = true;
        spinBtn.disabled = true;

        // pilih pemenang secara acak dari availableIndices
        const randomIdx = Math.floor(Math.random() * availableIndices.length);
        const winnerGlobalIdx = availableIndices[randomIdx];
        const winner = guestsList[winnerGlobalIdx];

        // Cari posisi segmen di wheelSegments (berdasarkan nama)
        const segmentPos = wheelSegments.findIndex(seg => seg.name === winner.name && seg.company === winner.company);
        if (segmentPos === -1) { // fallback
            currentSpinInProgress = false;
            spinBtn.disabled = false;
            showToast("Error internal, coba lagi", true);
            return;
        }
        const totalSeg = wheelSegments.length;
        const anglePer = (Math.PI * 2) / totalSeg;
        // target sudut agar segmen tepat di pointer (pointer di sudut 0 rad)
        let targetRot = (- (segmentPos * anglePer) - (anglePer/2));
        const extraRounds = (Math.random() * 8 + 10) * 2 * Math.PI; // 10-18 putaran
        let finalDelta = targetRot - (currentRotation % (Math.PI*2)) + extraRounds;
        const startRotation = currentRotation;
        const startTime = performance.now();

        function animateSpin(now) {
            const elapsed = now - startTime;
            let t = Math.min(1, elapsed / SPIN_DURATION);
            // easing cubic out: semakin lambat di akhir
            const ease = 1 - Math.pow(1 - t, 3);
            const newRotation = startRotation + finalDelta * ease;
            currentRotation = newRotation % (Math.PI * 2);
            drawWheel();
            if (t < 1) {
                requestAnimationFrame(animateSpin);
            } else {
                // finish: set presisi
                currentRotation = targetRot;
                while (currentRotation < 0) currentRotation += Math.PI*2;
                currentRotation %= Math.PI*2;
                drawWheel();
                // simpan pemenang + hadiah
                saveWinnerWithPrize(winner, selectedPrize.name);
                currentSpinInProgress = false;
                spinBtn.disabled = false;
                startConfetti();
            }
        }
        requestAnimationFrame(animateSpin);
    }

    async function saveWinnerWithPrize(winner, prizeName) {
        try {
            // cek stok sebelum simpan (validasi double)
            const prizeItem = prizes.find(p => p.name === prizeName);
            if (!prizeItem || prizeItem.stock <= 0) {
                showToast(`Maaf, stok ${prizeName} sudah habis! Refresh halaman`, true);
                return;
            }
            // kurangi stok di memori
            prizeItem.stock--;
            renderPrizeOptions();

            // simpan ke firebase
            const newWinner = {
                name: winner.name,
                company: winner.company,
                prize: prizeName,
                timestamp: Date.now()
            };
            await winnersRef.push(newWinner);
            // reload history dan update state
            await loadWinnersHistory();
            updateAvailableIndices();
            drawWheel();
            updateStatsUI();
            // tampilkan di kartu pemenang
            document.getElementById('winnerName').innerHTML = winner.name;
            document.getElementById('winnerCompany').innerHTML = `<i class="fas fa-building"></i> ${winner.company}`;
            document.getElementById('winnerPrizeDisplay').innerHTML = `<i class="fas fa-gift"></i> ${prizeName}`;
            showToast(`🎉 Selamat! ${winner.name} mendapatkan ${prizeName} 🎉`, false);
        } catch(e) { showToast("Gagal simpan pemenang", true); }
    }

    async function resetAllWinners() {
        if (!confirm("⚠️ RESET TOTAL: Semua history pemenang dan stok hadiah akan dikembalikan. Lanjutkan?")) return;
        showLoading(true);
        try {
            await winnersRef.remove();
            winnersHistory = [];
            prizes.forEach(p => p.stock = p.initialStock);
            selectedPrize = null;
            renderPrizeOptions();
            await loadWinnersHistory(); // reload kosong
            updateAvailableIndices();
            drawWheel();
            updateStatsUI();
            document.getElementById('winnerName').innerHTML = "—";
            document.getElementById('winnerCompany').innerHTML = "—";
            document.getElementById('winnerPrizeDisplay').innerHTML = "—";
            showToast("Semua data pemenang telah direset!", false);
        } catch(e) { showToast("Gagal reset", true); }
        finally { showLoading(false); }
    }

    function renderHistory() {
        const historyDiv = document.getElementById('historyList');
        if (!winnersHistory.length) {
            historyDiv.innerHTML = '<div style="text-align:center; color:#aaa; padding:15px;">Belum ada pemenang, putar roda!</div>';
            return;
        }
        historyDiv.innerHTML = winnersHistory.map(w => `
            <div class="history-item">
                <span class="history-name"><i class="fas fa-user-check"></i> ${escapeHtml(w.name)}</span>
                <span class="history-prize">🎁 ${escapeHtml(w.prize)}</span>
                <span class="history-date">${new Date(w.timestamp).toLocaleString('id-ID')}</span>
            </div>
        `).join('');
    }

    function escapeHtml(str) { if(!str) return ''; return str.replace(/[&<>]/g, function(m){if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;}); }

    // Event & init
    document.getElementById('spinButton').addEventListener('click', spinWheel);
    document.getElementById('resetAllBtn').addEventListener('click', resetAllWinners);

    // auth admin
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('access') !== 'admin2026') {
        const pwd = prompt('🔐 Password Admin Lucky Draw:');
        if (pwd !== 'admin2026') { alert('Akses ditolak!'); window.location.href = 'index.html'; }
    }

    loadGuests().then(() => drawWheel());
    window.addEventListener('resize', () => drawWheel());
</script>
</body>
</html>